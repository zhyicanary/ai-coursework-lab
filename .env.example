# LLM 后端选择: "ollama" 或 "deepseek"
LLM_BACKEND=ollama

# Ollama 配置 (本地)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma3:latest

# DeepSeek API 配置 (云端)
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Embedding 模型（Ollama 本地）
EMBEDDING_MODEL=qwen3-embedding:8b

# ChromaDB 持久化路径（代码硬编码为 data/chromadb/）
# CHROMA_PERSIST_DIR=./data/chromadb

# 文档分块配置
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 检索配置
TOP_K=5

# ==========================================================
# 第三方 API Key（不填则使用模拟数据）
# ==========================================================

# 和风天气 API Key（免费注册：https://dev.qweather.com）
# 填入后 get_weather 将查询实时天气预报
# 不填或留空则使用本地模拟数据
WEATHER_API_KEY=

# 高德地图 Web API Key（免费注册：https://lbs.amap.com）
# 填入后 search_attractions 将查询真实景点 POI
# 不填或留空则使用本地模拟数据
AMAP_API_KEY=
